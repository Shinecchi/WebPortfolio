# Copy this file to .env.local and fill in real values.
# Do not commit .env.local (it should already be in .gitignore).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Mailbox that should receive contact form submissions. Typically the same
# address as `personal.email` in src/content/site-content.ts (the address
# shown publicly in the footer), but kept separate here in case you want
# submissions routed to a different inbox.
CONTACT_TO_EMAIL=

# "From" address used when sending via Resend. Must be a verified
# sender/domain in your Resend account. Optional - if unset, the route
# falls back to Resend's default onboarding sender.
CONTACT_FROM_EMAIL=
